{
  "name": "dsh-set-model",
  "version": "0.1.0",
  "description": "Dynamic model and reasoning-effort switching for DeepSeek Harness (DSH): set_model / list_models agent tools, plan-mode auto-transition, provider whitelist and context-window guards, active-model runtime context injection. dsh-set-model：为 DSH 提供动态模型与思考深度切换——Agent 自主调模工具（set_model / list_models）、Plan 模式自动升降级、Provider 白名单与上下文窗口护栏、活跃模型运行时上下文注入。",
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-switching",
    "model-selection",
    "reasoning-effort",
    "plan-mode",
    "llm",
    "agent-tools",
    "模型切换",
    "模型选择",
    "思考深度",
    "推理",
    "规划模式"
  ],
  "license": "MIT",
  "author": "johnnren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-set-model.git"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-set-model#readme",
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-set-model/issues"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-default-model": "0.1.2-rc.1",
    "@deepseek-ai/dsh-plan-mode": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.1.2-rc.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
